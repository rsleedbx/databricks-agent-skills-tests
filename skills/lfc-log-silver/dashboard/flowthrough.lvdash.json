{
 "datasets": [
  {
   "name": "cdc",
   "displayName": "CDC events by minute",
   "queryLines": [
    "SELECT date_trunc('MINUTE', coalesce(timestamp_micros(value:ts_ns::BIGINT DIV 1000), timestamp_millis(value:ts_ms::BIGINT))) AS minute, substring_index(destination, '.', -1) AS table_name, count(*) AS events ",
    "FROM cdc_log WHERE operation NOT IN ('read', 'resolved') GROUP BY ALL"
   ]
  },
  {
   "name": "lag",
   "displayName": "Newest change",
   "queryLines": [
    "SELECT timestampdiff(SECOND, max(coalesce(timestamp_micros(value:ts_ns::BIGINT DIV 1000), timestamp_millis(value:ts_ms::BIGINT))), current_timestamp()) AS newest_age_s, count(*) AS events FROM cdc_log ",
    "WHERE operation NOT IN ('read', 'resolved')"
   ]
  },
  {
   "name": "tables",
   "displayName": "Each table: snapshot, rate and route",
   "queryLines": [
    "SELECT name AS table_name, get_json_object(route, '$.destination') AS cdc, replace(get_json_object(route, '$.snapshot_table'), '`', '') AS snap, concat(current_catalog(), '.', current_schema(), '.', name) AS combined, concat('__HOST__/dashboardsv3/__DASHBOARD__/published/pages/raw_cdc?o=__WSID__&f_raw_cdc%7Ef-destination.s=', url_encode(get_json_object(route, '$.destination'))) AS cdc_url, concat('__HOST__/explore/data/', replace(replace(get_json_object(route, '$.snapshot_table'), '`', ''), '.', '/'), '?o=__WSID__&activeTab=sample') AS snap_url, concat('__HOST__/explore/data/', current_catalog(), '/', current_schema(), '/', name, '?o=__WSID__&activeTab=sample') AS combined_url, CASE WHEN get_json_object(route, '$.why') <> 'observing' OR get_json_object(route, '$.why') IS NULL THEN 'in silver' WHEN get_json_object(route, '$.snapshot_table') IS NULL THEN 'waiting' ELSE 'ready' END AS snapshot, get_json_object(route, '$.silver') AS silver, coalesce(get_json_object(route, '$.proposed.silver'), get_json_object(route, '$.silver')) AS proposed, coalesce(get_json_object(route, '$.proposed.class'), get_json_object(route, '$.class')) AS class, get_json_object(route, '$.proposed.why') AS why, events, timestamp_seconds(at) AS measured_at , CASE WHEN get_json_object(route, '$.why') = 'observing' AND get_json_object(route, '$.snapshot_table') IS NULL THEN 1 ELSE 0 END AS is_waiting FROM _flowthrough ORDER BY events DESC, name"
   ]
  },
  {
   "name": "silver",
   "displayName": "Stored silver tables",
   "queryLines": [
    "SELECT target AS table_name, kind, position, rows, seconds, updated_at FROM _log_silver ORDER BY updated_at DESC"
   ]
  },
  {
   "name": "raw_cdc",
   "displayName": "Raw CDC events",
   "queryLines": [
    "SELECT split_part(destination, '.', 1) AS source, CASE WHEN size(split(destination, '[.]')) >= 4 THEN split_part(destination, '.', 2) END AS database_name0, element_at(split(destination, '[.]'), -2) AS schema_name, element_at(split(destination, '[.]'), -1) AS table_name, coalesce(value:source:db::STRING, CASE WHEN size(split(destination, '[.]')) >= 4 THEN split_part(destination, '.', 2) END) AS database_name, destination, coalesce(timestamp_micros(value:ts_ns::BIGINT DIV 1000), timestamp_millis(value:ts_ms::BIGINT)) AS event_time, operation, to_json(key) AS key, to_json(value:after) AS after, to_json(value:source) AS source_position FROM cdc_log WHERE operation NOT IN ('resolved') ORDER BY event_time DESC"
   ]
  },
  {
   "name": "tables_map",
   "displayName": "Each table: source, database, schema, its snapshot and silver",
   "queryLines": [
    "SELECT split_part(get_json_object(route, '$.destination'), '.', 1) AS source, CASE WHEN size(split(get_json_object(route, '$.destination'), '[.]')) >= 4 THEN split_part(get_json_object(route, '$.destination'), '.', 2) END AS database_name, element_at(split(get_json_object(route, '$.destination'), '[.]'), -2) AS schema_name, element_at(split(get_json_object(route, '$.destination'), '[.]'), -1) AS table_name, get_json_object(route, '$.destination') AS destination, replace(get_json_object(route, '$.snapshot_table'), '`', '') AS snapshot_full, concat(current_catalog(), '.', current_schema(), '.', name) AS silver_full FROM _flowthrough ORDER BY destination"
   ]
  },
  {
   "name": "snap_rows",
   "displayName": "The chosen table's snapshot rows",
   "queryLines": [
    "SELECT r AS row_number, c AS column_name, v AS value FROM (",
    "SELECT row_number() OVER (ORDER BY j) AS r, from_json(j, 'map<string,string>') AS m FROM (",
    "SELECT to_json(struct(*)) AS j FROM IDENTIFIER(concat('`', replace(:snapshot_table, '.', '`.`'), '`')) WHERE :snapshot_table <> '_flowthrough' LIMIT 1000)) ",
    "LATERAL VIEW explode(m) e AS c, v"
   ],
   "parameters": [
    {
     "displayName": "snapshot_table",
     "keyword": "snapshot_table",
     "dataType": "STRING",
     "defaultSelection": {
      "values": {
       "dataType": "STRING",
       "values": [
        {
         "value": "_flowthrough"
        }
       ]
      }
     }
    }
   ]
  },
  {
   "name": "silver_rows",
   "displayName": "The chosen table's silver rows (snapshot + log)",
   "queryLines": [
    "SELECT r AS row_number, c AS column_name, v AS value FROM (",
    "SELECT row_number() OVER (ORDER BY j) AS r, from_json(j, 'map<string,string>') AS m FROM (",
    "SELECT to_json(struct(*)) AS j FROM IDENTIFIER(concat('`', replace(:silver_table, '.', '`.`'), '`')) WHERE :silver_table <> '_flowthrough' LIMIT 1000)) ",
    "LATERAL VIEW explode(m) e AS c, v"
   ],
   "parameters": [
    {
     "displayName": "silver_table",
     "keyword": "silver_table",
     "dataType": "STRING",
     "defaultSelection": {
      "values": {
       "dataType": "STRING",
       "values": [
        {
         "value": "_flowthrough"
        }
       ]
      }
     }
    }
   ]
  }
 ],
