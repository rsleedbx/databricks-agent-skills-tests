{
 "datasets": [
  {
   "name": "plan",
   "displayName": "plan",
   "queryLines": [
    "SELECT tbl, members, variant, role, class, cell, snapshot_by, log, key_kind, why FROM routing_plan WHERE round = (SELECT max(round) FROM routing_plan) ORDER BY members DESC, tbl"
   ]
  },
  {
   "name": "plan_history",
   "displayName": "plan_history",
   "queryLines": [
    "SELECT round, tbl, role, class, cell, log, introspection_runs, why FROM routing_plan ORDER BY round DESC, tbl"
   ]
  },
  {
   "name": "decisions",
   "displayName": "decisions",
   "queryLines": [
    "SELECT tbl, override_role, override_class, override_cell, override_snapshot_by, override_log, note, `by`, at FROM routing_decisions ORDER BY tbl"
   ]
  },
  {
   "name": "introspection",
   "displayName": "introspection",
   "queryLines": [
    "SELECT run, source, at, status, tables, changes, error FROM introspection_runs ORDER BY at DESC"
   ]
  },
  {
   "name": "iterations",
   "displayName": "iterations",
   "queryLines": [
    "SELECT n, `by`, at, note FROM routing_iteration ORDER BY n DESC"
   ]
  },
  {
   "name": "cdc_runs",
   "displayName": "cdc_runs",
   "queryLines": [
    "SELECT run, source, at, action, status, tables, added, dropped, error FROM cdc_runs ORDER BY at DESC"
   ]
  },
  {
   "name": "snapshot_runs",
   "displayName": "snapshot_runs",
   "queryLines": [
    "SELECT source, tbl, at, method, status, rows, position, snapshot_table, error FROM snapshot_runs ORDER BY at DESC"
   ]
  },
  {
   "name": "ingestion_runs",
   "displayName": "ingestion_runs",
   "queryLines": [
    "SELECT run, source, at, status, plan_round, logs, snapshots, error FROM ingestion_runs ORDER BY at DESC"
   ]
  }
 ],
