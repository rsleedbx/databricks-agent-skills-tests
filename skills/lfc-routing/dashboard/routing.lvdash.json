   "pageType": "PAGE_TYPE_CANVAS",
   "layout": [
    {
     "widget": {
      "name": "plan_md",
      "multilineTextboxSpec": {
       "lines": [
        "**The latest plan.** A row a table, or a group of repeating tables (members). Change a choice in Decisions (or ask Genie), then add a row to routing_iteration: the next round shows it here."
       ]
      }
     },
     "position": {
      "x": 0,
      "y": 0,
      "width": 6,
      "height": 2
     }
    },
